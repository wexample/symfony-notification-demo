{
  "name": "wexample/symfony-notification-demo",
  "description": "Demo of symfony-notification: notifications sent on request, a reminder once per window, and the teams of symfony-user-demo telling their members",
  "version": "2.0.10",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyNotificationDemo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=18.0.2",
    "wexample/symfony-loader": ">=25.1.0",
    "wexample/symfony-design-system": ">=39.0.3",
    "wexample/symfony-notification": ">=2.1.5",
    "wexample/symfony-notification-ds": ">=2.0.8",
    "wexample/symfony-user": ">=14.0.4",
    "wexample/symfony-user-demo": ">=8.0.3"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}